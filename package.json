{
  "name": "crawler",
  "version": "0.1.0",
  "private": true,
  "description": "Fashion SKU crawler for kiko.ai — Cafe24 + Shopify harvester writing into Postgres + R2",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "crawl": "dotenv -e .env -e .env.local -- tsx src/crawl.ts",
    "import:products": "dotenv -e .env -e .env.local -- tsx src/import-products.ts",
    "sync:catalog": "dotenv -e .env -e .env.local -- tsx src/sync-catalog.ts",
    "match:catalog-pair": "dotenv -e .env -e .env.local -- tsx src/sync-catalog.ts --cross-shop-auto-match",
    "match:catalog-cross-shop": "dotenv -e .env -e .env.local -- tsx src/match-catalog-cross-shop.ts",
    "catalog:pipeline": "dotenv -e .env -e .env.local -- tsx src/catalog-pipeline.ts",
    "enrich:product-features": "dotenv -e .env -e .env.local -- tsx src/enrich-product-features.ts",
    "import:attributes": "dotenv -e .env -- tsx src/import-attributes.ts",
    "import:brand-nodes": "dotenv -e .env -- tsx src/import-brand-nodes.ts",
    "probe:reviews": "dotenv -e .env -- tsx src/probe-reviews.ts",
    "test:detail": "dotenv -e .env -- tsx src/test-detail-crawl.ts",
    "test:parser": "dotenv -e .env -- tsx src/test-parser.ts",
    "brand-crawl": "dotenv -e .env.local -- tsx src/brand-crawl.ts",
    "recrawl": "dotenv -e .env -e .env.local -- tsx src/recrawl-batch.ts",
    "refresh": "dotenv -e .env -e .env.local -- tsx src/refresh-listing.ts",
    "refresh:batch": "dotenv -e .env -e .env.local -- tsx tools/manage-refresh-batch.ts",
    "refresh:candidates": "dotenv -e .env -e .env.local -- tsx src/refresh-candidates.ts",
    "enrich:products": "dotenv -e .env -e .env.local -- tsx src/enrich-products-file.ts",
    "smoke:qwen": "dotenv -e .env -e .env.local -- tsx tools/qwen-smoke.ts",
    "recollect:metrics": "dotenv -e .env -e .env.local -- tsx tools/recollect-metrics.ts",
    "invalidate:embeddings": "dotenv -e .env -e .env.local -- tsx tools/invalidate-changed-embeddings.ts",
    "repair:product-platforms": "dotenv -e .env -e .env.local -- tsx tools/repair-product-platforms.ts",
    "repair:product-gender": "dotenv -e .env -e .env.local -- tsx src/repair-product-gender.ts",
    "propose:site-gender": "dotenv -e .env -e .env.local -- tsx tools/propose-site-gender.ts",
    "repair:product-subcategory": "dotenv -e .env -e .env.local -- tsx src/repair-product-subcategory.ts",
    "repair:product-images": "dotenv -e .env -e .env.local -- tsx src/repair-product-images.ts",
    "repair:image-contamination": "dotenv -e .env -e .env.local -- tsx tools/repair-image-contamination.ts",
    "select:product-images": "dotenv -e .env -e .env.local -- tsx src/select-product-images.ts",
    "poc:product-extraction": "dotenv -e .env -e .env.local -- tsx tools/product-extraction-poc.ts",
    "audit:brand-homepages": "dotenv -e .env -e .env.local -- tsx tools/audit-missing-brand-homepages.ts",
    "sync:brand-homepages": "dotenv -e .env -e .env.local -- tsx tools/update-source-review-homepages.ts --apply",
    "sync:brand-homepage-reviews": "dotenv -e .env -e .env.local -- tsx tools/update-homepage-review-classifications.ts --apply",
    "repair:sculpstore-brand-mapping": "dotenv -e .env -e .env.local -- tsx tools/repair-sculpstore-brand-contamination.ts",
    "scaffold:platform": "tsx tools/scaffold-platform.ts",
    "fx:refresh": "tsx tools/refresh-fx-snapshot.ts",
    "spike:lightpanda": "dotenv -e .env -e .env.local -- tsx src/spikes/lightpanda-poc.ts",
    "test": "sh -c 'node --test --import tsx ./tests/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.83",
    "@supabase/supabase-js": "^2.100.1",
    "ai": "^6.0.222",
    "llm-scraper": "^2.0.0",
    "onnxruntime-node": "^1.27.0",
    "playwright": "^1.58.2",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "dotenv-cli": "^11.0.0",
    "puppeteer-core": "^25.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "onnxruntime-node",
      "tesseract.js"
    ]
  }
}
