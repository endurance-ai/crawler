# 매일 독립 timer로 실행되는 신규상품 LLM worker — **연구실 배치 서버 프로필**.
# brand_nodes 를 만들지 않으며 정확히 매칭된 기존 브랜드 상품만 적재한다.
#
# --limit=1000은 총 처리 상한이고 실제 종료는 90분 예산이 우선한다. 이 워커의
# 병목은 LLM 호출이므로 큐 적체와 건당 시간을 함께 보고 조정한다.
[Unit]
Description=kiko.ai refresh candidate LLM enrichment — lab batch host
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/kjk/kiko-crawler-runtime
Environment=PATH=/home/kjk/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/home/kjk
Environment=CI=true
Environment=QWEN_ENABLED=true
# Candidate normalization uses the single primary Qwen worker. Requiring 8002
# made the entire scheduled run fail whenever the optional second worker or
# its tunnel was absent, even while 8001 was healthy.
Environment=QWEN_BASE_URLS=http://127.0.0.1:8001/v1
Environment=QWEN_MODEL=qwen3-vl-30b-awq
Environment=QWEN_TIMEOUT_MS=45000
Environment=QWEN_MAX_RETRIES=2
Environment=QWEN_CONCURRENCY_PER_ENDPOINT=1
# --country=KR: 큐 75,404건 중 KR 이 58,917건(78%)이고 운영 방침이 한국 브랜드
# 우선이다. 후보 1건 = 상세 크롤 + LLM 1회라 대상 아닌 것을 태우면 그대로 비용이다.
# 비KR 16,487건은 큐에 남는다 — 방침이 바뀌면 이 플래그만 빼면 전량으로 돌아간다.
ExecStart=/home/kjk/kiko-crawler-runtime/scripts/run-refresh-candidates.sh --budget-minutes=90 --limit=1000 --concurrency=2 --country=KR
TimeoutStartSec=7200

[Install]
WantedBy=default.target
