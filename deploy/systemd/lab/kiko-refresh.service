# 리스트-only 재고/가격 갱신 (일상 배치) — **연구실 배치 서버 프로필**.
#
# dev-app EC2 프로필(../kiko-refresh.service)과 다른 점:
#   · Postgres 가 동거하지 않는다 → 리소스 캡의 존재 이유가 사라졌다.
#     EC2 의 MemoryMax=1500M / CPUQuota=150% 는 4GB 에서 DB 를 보호하기 위한
#     것이었다. 여기서는 실측 후 정하고, 근거 없이 그 값을 옮겨오지 않는다.
#   · DB 가 원격이다 → 왕복 지연이 붙는다 (실측 p50 13ms, 원격 기준).
#     배치 쓰기가 이미 청킹되어 있어 한 바퀴 last_seen_at 갱신은 ~20초다.
#   · 사용자/경로/HOME 이 다르다.
#   · x86 이면 Chrome 채널을 쓸 수 있다 (EC2 는 ARM 이라 chromium 강제였다).
#
# 설치 전 반드시 deploy/lab-server-migration.md 의 체크리스트를 볼 것 —
# 특히 **첫 실행은 --ignore-backoff** 가 필요하다 (서킷브레이커가 EC2 네트워크에서
# 쌓인 실패 연쇄를 그대로 물려받는다).
[Unit]
Description=kiko.ai listing refresh (stock/price only) — lab batch host
After=network-online.target
Wants=network-online.target
OnSuccess=kiko-refresh-candidates.service

[Service]
Type=oneshot
User=kjk
WorkingDirectory=/home/kjk/kiko-crawler
# corepack/node 가 ~/.local/bin 에 있고 systemd 기본 PATH 에는 없다 — 없으면
# 래퍼의 `corepack pnpm` 이 command not found 로 죽는다 (실측 2026-07-31).
Environment=PATH=/home/kjk/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/home/kjk
# env 는 .env / .env.local 을 npm 스크립트의 dotenv 가 읽는다 — EnvironmentFile 불필요.
ExecStart=/home/kjk/kiko-crawler/scripts/run-refresh.sh --budget-minutes=480 --concurrency=4
# 예산 480분 + wrapper 오버헤드 여유
TimeoutStartSec=32400
# 동시성 4 + 예산 480분의 근거: 한 패스 총 크롤시간 실측 30.6h(357 소스) →
# 4 에서 7.7h. 연속 타이머와 합쳐 하루 ~3바퀴로 '매일 한 바퀴' 목표를 넘긴다.
# 보수적 시작값이다 — 한 패스 완주 후 메모리/부하를 보고 6 → 8 로 올린다
# (deploy/lab-server-migration.md §5).
# ⚠️ 리소스 캡은 의도적으로 비워 뒀다. DB 동거가 없으므로 EC2 값을 그대로
# 옮기면 근거 없이 처리량만 깎는다. 첫 런 관측 후 필요하면 여기에 추가한다.

[Install]
WantedBy=multi-user.target
