[Unit]
Description=kiko.ai listing refresh (stock/price only) — lab batch host
After=network-online.target
Wants=network-online.target
OnSuccess=kiko-refresh-candidates.service

[Service]
Type=oneshot
WorkingDirectory=/home/kjk/kiko-crawler-runtime
Environment=PATH=/home/kjk/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/home/kjk
Environment=CI=true
# Production runs use a validated checkout. Code and dependencies are updated
# explicitly during deployment, never from inside a running batch.
Environment=BATCH_SKIP_UPDATE=true
ExecStart=/home/kjk/kiko-crawler-runtime/scripts/run-refresh.sh --budget-minutes=600 --source-slice-minutes=10 --concurrency=6
# Normal claiming stops at 04:00. Page-boundary draining has 30 minutes, so the
# 90-minute candidate worker can finish by 06:00 ahead of the 07:00 DB backup.
TimeoutStartSec=37800

[Install]
WantedBy=default.target
