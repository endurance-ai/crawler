# 한 런이 끝난 뒤 15분 쉬고 다음 런을 시작한다 — EC2 프로필과 동일 정책.
# 간격을 줄이기 전에 한 바퀴 실소요를 먼저 잰다 (deploy/lab-server-migration.md §5).
[Unit]
Description=Continuous kiko.ai listing refresh — lab batch host

[Timer]
# user unit 이라 OnBootSec 의 기준은 유저 매니저 기동 시점이다. Linger=yes 이므로
# 로그인 없이 부팅 직후 뜬다.
OnBootSec=10min
OnUnitInactiveSec=15min
AccuracySec=1min
Unit=kiko-refresh.service

[Install]
WantedBy=timers.target
