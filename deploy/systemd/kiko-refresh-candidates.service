# kiko-refresh가 성공한 뒤 시작되는 별도 신규상품 LLM worker.
# brand_nodes를 만들지 않으며 정확히 매칭된 기존 브랜드 상품만 적재한다.
[Unit]
Description=kiko.ai refresh candidate LLM enrichment
After=network-online.target kiko-refresh.service
Wants=network-online.target

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/opt/kiko-crawler
ExecStart=/opt/kiko-crawler/scripts/run-refresh-candidates.sh --limit=50 --concurrency=1
MemoryMax=1500M
CPUQuota=150%
Nice=15
TimeoutStartSec=7200
Environment=HOME=/home/ec2-user

[Install]
WantedBy=multi-user.target
